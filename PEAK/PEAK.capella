                ReqIFName="Produce Potable Water" ReqIFText="The water purification equipment shall produce potable water. Rationale:To meet health and hygiene needs.">
              <ownedRelations xsi:type="CapellaRequirements:CapellaIncomingRelation"
                  id="3422938a-3ebf-4488-8005-c36d8aa691df" source="#53773e29-a148-481e-aada-47987c2a1357"
